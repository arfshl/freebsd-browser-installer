install_librewolf()
{
    do_chroot "apt update && apt install extrepo -y"
    do_chroot "extrepo enable librewolf && extrepo update librewolf"
    do_chroot "apt update && apt install librewolf -y"
}

uninstall_librewolf()
{
    do_chroot "apt remove -y librewolf && apt autoremove -y && apt clean"
}

install_widevine()
{
    do_chroot 'install -d -m 0755 /compat/debian/usr/lib/WidevineCdm'
    do_chroot 'curl -fsSL https://dl.google.com/linux/deb/pool/main/g/google-chrome-stable/google-chrome-stable_133.0.6943.53-1_amd64.deb -o /tmp/chrome.deb'
    do_chroot 'cd /tmp && ar x chrome.deb && tar -xf data.tar.xz ./opt/google/chrome/WidevineCdm'
    do_chroot 'cp -R /tmp/opt/google/chrome/WidevineCdm/* /usr/lib/WidevineCdm/'
    do_chroot 'rm -rf /tmp/chrome.deb /tmp/control.tar.xz /tmp/data.tar.xz /tmp/debian-binary /tmp/opt'
}

uninstall_widevine()
{
    do_chroot 'rm -rf /usr/lib/WidevineCdm'
}

set_timezone()
{
    printf "0.0 0 0.0\n0\nUTC\n" > ${chroot_path}/etc/adjtime
    cp "/usr/share/zoneinfo/$(cat /var/db/zoneinfo)" \
       ${chroot_path}/etc/localtime
    do_chroot -i "dpkg-reconfigure --frontend noninteractive tzdata"
}

install_chroot_base()
{
    [ -f ${chroot_path}/etc/os-release ] && return
    mk_mount_dirs
    install_rc
    sysrc linux_enable=NO
    sysrc debian_enable=YES
    service debian start || bail "Failed to start debian service"
    install_packages
    debootstrap --arch=amd64 --no-check-gpg ${debian_version} ${chroot_path} || \
        bail "debootstrap failed"
    echo "APT::Cache-Start 251658240;" > \
        ${chroot_path}/etc/apt/apt.conf.d/00aptitude

    :>${chroot_path}/etc/apt/sources.list
    cat > ${chroot_path}/etc/apt/sources.list <<EOF
deb http://deb.debian.org/debian ${debian_version} main contrib non-free non-free-firmware
deb http://deb.debian.org/debian ${debian_version}-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security ${debian_version}-security main contrib non-free non-free-firmware
EOF

    fix_ld_path
    set_timezone
    service debian start
    install_apt_packages

    # Accessing the dbus socket doesn't work if /var/run is a symlink
    [ -L ${chroot_path}/var/run ] && unlink ${chroot_path}/var/run
    
    do_chroot "groupadd --system messagebus"
    do_chroot "useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin -g messagebus messagebus"

    do_chroot "groupadd --system polkitd"
    do_chroot "useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin -g polkitd polkitd"

    do_chroot "groupadd --system _network || true"
    do_chroot "groupadd --system systemd-network || true"
    do_chroot "useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin -g systemd-network systemd-network || true"
}

uninstall_chroot_base()
{
    local path
    path=$(realpath ${chroot_path})
    [ $? -ne 0 ] && exit 1

    if [ "${path}" = "/" ]; then
        echo "chroot_path must not be '/'" >&2
        exit 1
    fi
    umount_chroot
    rm -rf "${path}"
    rm -f "${prefix}/etc/rc.d/debian"
    sysrc -x debian_enable
}

upgrade_chroot()
{
    local flags="-q -y --allow-downgrades"
    flags="${flags} --allow-remove-essential --allow-change-held-packages"
    do_chroot "apt-get update && apt dist-upgrade ${flags}"
    fix_ld_path
}

install_browser()
{
    local browser_name=$1

    if check_installed ${browser_name}; then
        echo "${browser_name} already installed" >&2
        exit 1
    fi
    install_chroot_base
    eval install_${browser_name}
    install_browser_files ${browser_name}
}

uninstall_browser()
{
    local browser_name=$1
    eval uninstall_${browser_name}
    uninstall_browser_files ${browser_name}
}

usage()
{
    echo "Usage: $0 install <widevine|brave|braveorigin|chrome|edge|vivaldi|opera|firefox|firefoxesr|firefoxdevedition|floorp|librewolf>"
    echo "       $0 uninstall <widevine|brave|braveorigin|chrome|edge|vivaldi|opera|firefox|firefoxesr|firefoxdevedition|floorp|librewolf>"
    echo "       $0 chroot <create|upgrade|delete>"
    exit 1
}


if [ $(id -u) -ne 0 ]; then
    echo "This script must be run as root" 1>&2
    exit 1
fi

[ $# -eq 0 ] && usage

while [ $# -gt 0 ]; do
    case "$1" in
    install)
        case $2 in
        widevine|brave|braveorigin|chrome|edge|vivaldi|opera|firefox|firefoxesr|firefoxdevedition|floorp|librewolf)
            browser=$2
            install_browser ${browser}
            exit 0
            ;;
        *)
            usage
            ;;
        esac
        shift
        ;;
    uninstall)
        case $2 in
        widevine|brave|braveorigin|chrome|edge|vivaldi|opera|firefox|firefoxesr|firefoxdevedition|floorp|librewolf)
            browser=$2
            uninstall_browser ${browser}
            exit 0
            ;;
        *)
            usage
            ;;
        esac
        shift
        ;;
    chroot|jail)
        case $2 in
        create)
            install_chroot_base
            exit 0
            ;;
        delete)
            uninstall_chroot_base
            exit 0
            ;;
        upgrade)
            upgrade_chroot
            exit 0
            ;;
        *)
            usage
            ;;
        esac
        shift
        ;;
    *)
        usage
        ;;
    esac
    shift
done