#!/bin/sh

chroot_path=@CHROOT_PATH@

if [ ! "${DBUS_SESSION_BUS_ADDRESS-}" ] &&
   command -v dbus-run-session > /dev/null 2>&1
then
	exec dbus-run-session -- "$0" "$@"
fi


get_pa_sock_path()
{
	PA_SOCK_PATH=$(sockstat -uw | awk -v me="$(whoami)" -F'[ \t]+' '
		$1 == me && $2 == "pulseaudio" && $6 ~ /native/ {
			print $6
			exit 0
		}'
	)
}

get_pa_sock_path
if [ -S "$PA_SOCK_PATH" ]; then
    export PULSE_SERVER=unix:$PA_SOCK_PATH
    export PULSE_COOKIE="$HOME/.config/pulse/cookie" 
    export PULSE_LATENCY_MSEC=0
    export PULSE_NO_SHM=1
fi

${chroot_path}/bin/@BROWSER@

